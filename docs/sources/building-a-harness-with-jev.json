              }
            ]
          },
          "entityRanges": [],
          "inlineStyleRanges": [],
          "key": "4p8d7",
          "text": "Thanks @huntlovell, @hwchase, @ccurme, @veryboldbagel, and Nathan Drenzer for their thoughtful review and contributions.",
          "type": "unstyled"
        }
      ],
