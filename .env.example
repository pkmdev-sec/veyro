# The key value stays in its own environment variable. Veyro stores only its name.
TYPESAFE_API_KEY=local

# Authoritative semantic provider. These values identify the pinned local baseline.
VEYRO_JEV_PROVIDER_ID=localjev-qwen3-14b
VEYRO_JEV_BASE_URL=http://127.0.0.1:8080
VEYRO_JEV_API_KEY_ENV=TYPESAFE_API_KEY
VEYRO_JEV_MODEL=jev-latest
VEYRO_JEV_CHECKPOINT=qwen3:14b@sha256:bdbd181c33f2ed1b31c972991882db3cf4d192569092138a7d29e973cd9debe8
VEYRO_JEV_TIMEOUT_SECONDS=180

# Optional shadow observer. Shadow scores are recorded but never drive policy.
# JEFF_API_KEY=<random-local-secret>
# VEYRO_JEV_SHADOW_PROVIDER_ID=jeff-gliformer-large-v1
# VEYRO_JEV_SHADOW_BASE_URL=http://127.0.0.1:8081
# VEYRO_JEV_SHADOW_API_KEY_ENV=JEFF_API_KEY
# VEYRO_JEV_SHADOW_MODEL=jev-latest
# VEYRO_JEV_SHADOW_CHECKPOINT=knowledgator/gliformer-large-v1@d0a4e53d09cebe6bc963dd9be319d4279084bb2d#sha256:f80b29199d66f878669f283703e4dba9fd726755dcc20aba1ed0d24fce4a23f1
# VEYRO_JEV_SHADOW_TIMEOUT_SECONDS=10
# VEYRO_JEV_SHADOW_MAX_STATE_CHARS=20000
# VEYRO_JEV_SHADOW_STATE_FORMAT=kv

# Stable exec is the default. Live steering requires opting into experimental App Server.
# VEYRO_CODEX_BACKEND=exec
# Set app-server only to opt into experimental Codex controls.
# VEYRO_STEERING_ENABLED=true
# VEYRO_MAX_STEERS_PER_WORKER=1
# VEYRO_STEERING_GRACE_SECONDS=30
