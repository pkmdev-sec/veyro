# Non-secret, pinned settings for the local jeff shadow canary.
# Set JEFF_API_KEYS to a strong secret in the parent shell before loading this file.
JEFF_MODEL=$HOME/.local/share/jeff/models/gliformer-large-v1
JEFF_MODEL_NAME=gliformer-large-v1
JEFF_MODEL_ALIASES=jev-latest,jev
JEFF_HOST=127.0.0.1
JEFF_PORT=8081
JEFF_BACKEND=torch
JEFF_DEVICE=mps
JEFF_DTYPE=float32
JEFF_ATTN=eager
JEFF_TEMPERATURE=3.2
JEFF_ISOLATE=nouls
JEFF_NOUL_MODE=yes_no
JEFF_STATE_FORMAT=kv
JEFF_COMPILE=0
JEFF_WARMUP=1
JEFF_MAX_BATCH=16
JEFF_MAX_WAIT_MS=5
JEFF_MAX_QUEUE=256
JEFF_MAX_STATE_CHARS=20000
JEFF_MAX_QUESTIONS=64
JEFF_MAX_LABELS=64
